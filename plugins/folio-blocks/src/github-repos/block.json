{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "folio/github-repos",
	"version": "0.1.0",
	"title": "GitHub Repositories",
	"category": "widgets",
	"icon": "editor-code",
	"description": "Shows public repositories from the GitHub API.",
	"keywords": [ "github", "repositories", "api" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"username": { "type": "string", "default": "akshapatel-dev" },
		"count": { "type": "number", "default": 6 },
		"sortBy": { "type": "string", "default": "updated" },
		"hideForks": { "type": "boolean", "default": true }
	},
	"textdomain": "folio-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}