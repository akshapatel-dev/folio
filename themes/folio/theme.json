{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "surface", "color": "#f8fafc", "name": "Surface" },
        { "slug": "contrast", "color": "#0f172a", "name": "Contrast" },
        { "slug": "muted", "color": "#64748b", "name": "Muted" },
        { "slug": "accent", "color": "#6366f1", "name": "Accent" },
        { "slug": "accent-dark", "color": "#4f46e5", "name": "Accent Dark" },
        { "slug": "accent-soft", "color": "#eef2ff", "name": "Accent Soft" },
        { "slug": "border", "color": "#e2e8f0", "name": "Border" },
        { "slug": "dark", "color": "#0f1113", "name": "Dark" },
        { "slug": "light", "color": "#ffffff", "name": "Light" }
      ],
      "gradients": [
        {
          "slug": "brand",
          "name": "Brand",
          "gradient": "linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large",
          "fluid": { "min": "1.125rem", "max": "1.375rem" } },
        { "slug": "x-large", "size": "2rem", "name": "X-Large",
          "fluid": { "min": "1.75rem", "max": "2.5rem" } },
        { "slug": "xx-large", "size": "3.5rem", "name": "XX-Large",
          "fluid": { "min": "2.25rem", "max": "4.5rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "XS" },
        { "slug": "30", "size": "1rem", "name": "S" },
        { "slug": "40", "size": "clamp(1.5rem, 2vw, 2rem)", "name": "M" },
        { "slug": "50", "size": "clamp(2.5rem, 4vw, 4rem)", "name": "L" },
        { "slug": "60", "size": "clamp(4rem, 8vw, 7rem)", "name": "XL" }
      ]
    },
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "shadow": {
      "presets": [
        { "slug": "soft", "name": "Soft",
          "shadow": "0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.08)" },
        { "slug": "lifted", "name": "Lifted",
          "shadow": "0 4px 8px rgba(15,23,42,.08), 0 24px 48px rgba(99,102,241,.18)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var(--wp--preset--spacing--40)",
        "right": "var(--wp--preset--spacing--40)"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "inherit" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } }
      },
      "heading": {
        "typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "600" },
        "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.75rem", "right": "1.75rem" } },
        "shadow": "var(--wp--preset--shadow--soft)",
        ":hover": { "color": { "background": "var(--wp--preset--color--accent-dark)" } }
      }
    },
    "blocks": {
        "core/site-title": {
            "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "800" },
            "elements": {
            "link": {
                "color": { "text": "var(--wp--preset--color--contrast)" },
                "typography": { "textDecoration": "none" }
            }
            }
        },
        "core/navigation": {
            "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
            "elements": {
            "link": {
                "typography": { "textDecoration": "none" },
                ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
            }
            }
        }
    }
  }
}